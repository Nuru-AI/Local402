{
  "name": "local402",
  "version": "0.4.0",
  "description": "Pay for any x402 agent service in your own currency, from your own wallet: local stablecoins on Celo, converted on Textile FX, paid straight to each seller. Holds nothing.",
  "main": "src/buyer.mjs",
  "scripts": {
    "start": "node src/server.mjs",
    "register": "node scripts/register-8004.mjs",
    "prices": "node scripts/prices.mjs",
    "mcp": "node src/mcp.mjs",
    "mcp-demo": "node scripts/mcp-demo.mjs",
    "payee-demo": "node scripts/payee-demo.mjs",
    "sippar-quote": "node scripts/sippar-quote.mjs",
    "sippar-demo": "node scripts/sippar-demo.mjs",
    "test": "node --test test/*.test.mjs",
    "direct-demo": "node scripts/direct-demo.mjs",
    "code-demo": "node scripts/code-wallet-demo.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@celo/attribution-tags": "^0.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^4.22.3",
    "ox": "^1.8.14",
    "viem": "^2.57.17",
    "zod": "^4.6.7"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "local402": "bin/local402.mjs",
    "local402-mcp": "src/mcp.mjs"
  },
  "exports": {
    ".": "./src/buyer.mjs",
    "./buyer": "./src/buyer.mjs",
    "./codes": "./src/codewallet.mjs",
    "./tx": "./src/tx.mjs",
    "./textile": "./src/textile.mjs",
    "./x402": "./src/x402.mjs",
    "./catalog": "./src/catalog.mjs",
    "./config": "./src/config.mjs",
    "./src/*": "./src/*"
  }
}
